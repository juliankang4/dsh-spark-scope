{
  "name": "dsh-spark-scope",
  "version": "0.0.1",
  "description": "Spark Scope's mini window in the DeepSeek Harness sidebar: decode, prefill and every node at a glance",
  "type": "module",
  "license": "MIT",
  "repository": "github:juliankang4/dsh-spark-scope",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "spark-scope",
    "dgx-spark",
    "vllm",
    "sglang",
    "monitoring"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-client.mjs",
    "pretest": "npm run build",
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24",
    "@types/react": "18.3.28",
    "typescript": "^6.0.3"
  }
}
